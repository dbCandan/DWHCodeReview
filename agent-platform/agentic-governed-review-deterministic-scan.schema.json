{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agentic-governed-review-deterministic-scan:1.0",
  "title": "Yönetilen inceleme kural tabanlı tarama kaydı",
  "description": "review-start komutunun staged içerikte kodla çalıştırdığı kesin başarısızlık detektörlerinin sonucu. Eşleşen değer, değerin özeti ve satır metni kayda girmez; yalnız detektör, dosya yolu ve satır aralığı yazılır. Yerel bir yürütmedir; üretim kabulü değildir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "canonicalization",
    "project_id",
    "run_id",
    "snapshot_sha256",
    "executor_ref",
    "limits",
    "status",
    "incomplete_reasons",
    "files",
    "detectors",
    "matches",
    "claim_boundary",
    "data_handling"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "GovernedReviewDeterministicScan"},
    "canonicalization": {"const": "kt-governed-review-deterministic-scan-json-v1"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "run_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 124,
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "executor_ref": {"const": "executor:governance-client/deterministic-scan"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_text_file_bytes", "max_matches"],
      "properties": {
        "max_text_file_bytes": {"const": 8388608},
        "max_matches": {"const": 512}
      }
    },
    "status": {"enum": ["complete", "incomplete"]},
    "incomplete_reasons": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["MATCH_LIMIT_EXCEEDED", "UNSCANNABLE_FILE"]}
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanned", "authority_matched", "skipped", "unscannable"],
      "properties": {
        "scanned": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryRelativePath"}
        },
        "authority_matched": {
          "description": "Taranmadı: otoriteyle birebir. Staged baytları iskele sahiplik manifestinin (.kt-scaffold/manifest.json) kayıtlı özetine birebir eşit ve yolu HEAD manifestinde zaten yönetilen dosyalar; yalnız yol yazılır.",
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryRelativePath"}
        },
        "skipped": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/fileNote", "properties": {"reason": {"enum": ["binary", "submodule"]}}}
        },
        "unscannable": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/fileNote", "properties": {"reason": {"enum": ["too-large", "not-utf8"]}}}
        }
      }
    },
    "detectors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detector_id",
          "agent_id",
          "scan_group",
          "severity",
          "validator",
          "hard_fail_list",
          "decision_effect",
          "detector_pack_sha256",
          "match_count"
        ],
        "properties": {
          "detector_id": {"$ref": "#/$defs/detectorId"},
          "agent_id": {"$ref": "#/$defs/agentRef"},
          "scan_group": {"$ref": "#/$defs/scanGroup"},
          "severity": {"$ref": "#/$defs/severity"},
          "validator": {"enum": [null, "tckn-checksum", "iban-mod97", "luhn-checksum"]},
          "hard_fail_list": {"enum": ["authoritative", "unresolved"]},
          "decision_effect": {"enum": ["hard-fail", "blocked-incomplete"]},
          "detector_pack_sha256": {"$ref": "#/$defs/sha256"},
          "match_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "matches": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "detector_id",
          "agent_id",
          "scan_group",
          "severity",
          "path",
          "start_line",
          "end_line",
          "summary"
        ],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/candidateId"},
          "detector_id": {"$ref": "#/$defs/detectorId"},
          "agent_id": {"$ref": "#/$defs/agentRef"},
          "scan_group": {"$ref": "#/$defs/scanGroup"},
          "severity": {"$ref": "#/$defs/severity"},
          "path": {"$ref": "#/$defs/repositoryRelativePath"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "summary": {"$ref": "#/$defs/summary"}
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_admission", "production_decision", "calibration_complete"],
      "properties": {
        "runtime_admission": {"const": false},
        "production_decision": {"const": false},
        "calibration_complete": {"const": false}
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched_value_stored",
        "matched_value_digest_stored",
        "line_text_stored",
        "source_content_stored"
      ],
      "properties": {
        "matched_value_stored": {"const": false},
        "matched_value_digest_stored": {"const": false},
        "line_text_stored": {"const": false},
        "source_content_stored": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "incomplete_reasons": {"maxItems": 0},
          "files": {"properties": {"unscannable": {"maxItems": 0}}}
        }
      },
      "else": {"properties": {"incomplete_reasons": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {"type": "string", "pattern": "^candidate:[0-9a-f]{32}$"},
    "detectorId": {
      "type": "string",
      "pattern": "^detector:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "agentRef": {
      "enum": [
        "agent:gereksinim-kapsami",
        "agent:kurumsal-mimari",
        "agent:kod-kalitesi",
        "agent:kod-inceleme",
        "agent:bilgi-guvenligi",
        "agent:uygulama-guvenligi",
        "agent:acik-kaynak-lisansi",
        "agent:gizlilik-kvkk",
        "agent:test-otomasyonu",
        "agent:dokumantasyon",
        "agent:devops",
        "agent:gozlemlenebilirlik"
      ]
    },
    "scanGroup": {"enum": ["blocking", "adjudication"]},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "fileNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "summary"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "reason": {"enum": ["binary", "submodule", "too-large", "not-utf8"]},
        "summary": {"$ref": "#/$defs/summary"}
      }
    }
  }
}
