{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:decision-explanation-templates:1.0",
  "title": "Belirlenimci Karar Açıklaması Şablon Kataloğu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "catalog_id",
    "catalog_version",
    "locale",
    "claim_boundary",
    "templates",
    "finding_templates",
    "finding_labels"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "DeterministicDecisionExplanationTemplateCatalog"},
    "catalog_id": {"const": "policy:governed-review-decision-explanations"},
    "catalog_version": {"const": "1.1.0"},
    "locale": {"const": "tr"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "HARD-FAIL", "FAIL", "BLOCKED_INCOMPLETE"],
      "properties": {
        "PASS": {
          "type": "object",
          "additionalProperties": false,
          "required": ["AGG_THRESHOLD_PASS", "AGG_THRESHOLD_WARNING"],
          "properties": {
            "AGG_THRESHOLD_PASS": {"$ref": "#/$defs/template"},
            "AGG_THRESHOLD_WARNING": {"$ref": "#/$defs/template"}
          }
        },
        "HARD-FAIL": {
          "type": "object",
          "additionalProperties": false,
          "required": ["AGG_HARD_FAIL"],
          "properties": {
            "AGG_HARD_FAIL": {"$ref": "#/$defs/template"}
          }
        },
        "FAIL": {
          "type": "object",
          "additionalProperties": false,
          "required": ["AGG_THRESHOLD_FAIL", "AGG_SECURITY_CRITICAL_VETO"],
          "properties": {
            "AGG_THRESHOLD_FAIL": {"$ref": "#/$defs/template"},
            "AGG_SECURITY_CRITICAL_VETO": {"$ref": "#/$defs/template"}
          }
        },
        "BLOCKED_INCOMPLETE": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AGG_MISSING_AGENT",
            "AGG_DUPLICATE_AGENT",
            "AGG_INVALID_SCHEMA",
            "AGG_RAW_SOURCE_REJECTED",
            "AGG_INTEGRITY_FAILURE",
            "AGG_REQUEST_DIGEST_MISMATCH",
            "AGG_AGENT_FAILED",
            "AGG_TIMEOUT",
            "AGG_LOW_CONFIDENCE",
            "AGG_PROHIBITED_AGENT",
            "AGG_UNEXPECTED_AGENT",
            "AGG_UNKNOWN_POLICY_VERSION",
            "AGG_AUTHORITATIVE_CONFLICT",
            "AGG_DETECTOR_EVIDENCE_INVALID",
            "AGG_FINDING_CLASSIFICATION_INVALID",
            "AGG_REQUIRED_HUMAN_EVIDENCE_MISSING",
            "AGG_REQUIRED_ADMISSION_EVIDENCE_MISSING",
            "AGG_TRACE_CONTEXT_INVALID",
            "AGG_RUN_EVIDENCE_INCOMPLETE"
          ],
          "properties": {
            "AGG_MISSING_AGENT": {"$ref": "#/$defs/template"},
            "AGG_DUPLICATE_AGENT": {"$ref": "#/$defs/template"},
            "AGG_INVALID_SCHEMA": {"$ref": "#/$defs/template"},
            "AGG_RAW_SOURCE_REJECTED": {"$ref": "#/$defs/template"},
            "AGG_INTEGRITY_FAILURE": {"$ref": "#/$defs/template"},
            "AGG_REQUEST_DIGEST_MISMATCH": {"$ref": "#/$defs/template"},
            "AGG_AGENT_FAILED": {"$ref": "#/$defs/template"},
            "AGG_TIMEOUT": {"$ref": "#/$defs/template"},
            "AGG_LOW_CONFIDENCE": {"$ref": "#/$defs/template"},
            "AGG_PROHIBITED_AGENT": {"$ref": "#/$defs/template"},
            "AGG_UNEXPECTED_AGENT": {"$ref": "#/$defs/template"},
            "AGG_UNKNOWN_POLICY_VERSION": {"$ref": "#/$defs/template"},
            "AGG_AUTHORITATIVE_CONFLICT": {"$ref": "#/$defs/template"},
            "AGG_DETECTOR_EVIDENCE_INVALID": {"$ref": "#/$defs/template"},
            "AGG_FINDING_CLASSIFICATION_INVALID": {"$ref": "#/$defs/template"},
            "AGG_REQUIRED_HUMAN_EVIDENCE_MISSING": {"$ref": "#/$defs/template"},
            "AGG_REQUIRED_ADMISSION_EVIDENCE_MISSING": {"$ref": "#/$defs/template"},
            "AGG_TRACE_CONTEXT_INVALID": {"$ref": "#/$defs/template"},
            "AGG_RUN_EVIDENCE_INCOMPLETE": {"$ref": "#/$defs/template"}
          }
        }
      }
    },
    "finding_templates": {
      "description": "Bir bulgunun `Neden:` ve `Dayanak:` satırlarının şablonları.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "basis", "basis_unmapped", "source_stated", "institutional"],
      "properties": {
        "reason": {"$ref": "#/$defs/findingTemplate"},
        "basis": {"$ref": "#/$defs/findingTemplate"},
        "basis_unmapped": {"$ref": "#/$defs/findingTemplate"},
        "source_stated": {"$ref": "#/$defs/findingTemplate"},
        "institutional": {"$ref": "#/$defs/findingTemplate"}
      }
    },
    "finding_labels": {
      "description": "Kullanıcıya görünen durum etiketleri, başvuru biçimleri ve kontrol başlıkları. Standartları, numaraları ve bağ durumlarını ortak standart başvurusu tanımı belirler; ISO kontrolünün yalnız kısa başlığı yazılır.",
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "formats", "titles"],
      "properties": {
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline-unverified", "unit-verified"],
          "properties": {
            "baseline-unverified": {"$ref": "#/$defs/label"},
            "unit-verified": {"$ref": "#/$defs/label"}
          }
        },
        "formats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ISO-IEC-27001",
            "KVKK-6698",
            "CWE",
            "OWASP-TOP-10",
            "PCI-DSS",
            "SLSA",
            "KT-AGENT-POLICY"
          ],
          "properties": {
            "ISO-IEC-27001": {"$ref": "#/$defs/label"},
            "KVKK-6698": {"$ref": "#/$defs/label"},
            "CWE": {"$ref": "#/$defs/label"},
            "OWASP-TOP-10": {"$ref": "#/$defs/label"},
            "PCI-DSS": {"$ref": "#/$defs/label"},
            "SLSA": {"$ref": "#/$defs/label"},
            "KT-AGENT-POLICY": {"$ref": "#/$defs/label"}
          }
        },
        "titles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:ISO-IEC-27001 A\\.[5-8]\\.[1-9][0-9]?|KVKK-6698 [1-9][0-9]?)$"
          },
          "additionalProperties": {"$ref": "#/$defs/label"}
        }
      }
    }
  },
  "$defs": {
    "findingTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "template_version", "text"],
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^finding-explanation:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "template_version": {"const": "1.0.0"},
        "text": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_tier",
        "deterministic_contract",
        "runtime_admission",
        "production_decision"
      ],
      "properties": {
        "evidence_tier": {"const": "L1"},
        "deterministic_contract": {"const": true},
        "runtime_admission": {"const": false},
        "production_decision": {"const": false}
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "template_version", "text"],
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^decision-explanation:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "template_version": {"const": "1.0.0"},
        "text": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    }
  }
}
