{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-record-chain.schema.json",
  "title": "GovernanceRecordChain",
  "description": "Ortak yönetişim kaydının zarfındaki chain alanı. Her (project_id, os_user) çifti cihazda bir akıştır; kayıt akıştaki önceki kaydın tam baytlarının SHA-256 özetini taşır. Cihazda değiştirilemezlik kanıtı değildir; kanıt yalnız toplayıcının doğrulama kaydıdır.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stream_id", "epoch", "sequence", "previous_sha256"],
      "properties": {
        "status": {"const": "linked"},
        "stream_id": {"$ref": "#/$defs/stream_id"},
        "epoch": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "previous_sha256": {"$ref": "#/$defs/sha256"},
        "epoch_reason": {"enum": ["head-unreadable"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stream_id", "reason"],
      "properties": {
        "status": {"const": "unavailable"},
        "stream_id": {"$ref": "#/$defs/stream_id"},
        "reason": {"enum": ["chain-path-unsafe", "chain-lock-timeout"]}
      }
    }
  ],
  "$defs": {
    "stream_id": {"type": "string", "pattern": "^stream-[0-9a-f]{32}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bound_files": {
      "description": "Yayın işaretinin bağladığı koşum dosyaları; çalışma durumu (work/, lease.json) girmez.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
