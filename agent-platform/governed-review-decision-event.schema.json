{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governed-review-decision-event.schema.json",
  "title": "GovernedReviewDecisionEvent",
  "description": "Yönetilen inceleme `HARD-FAIL` ya da `FAIL` kararı verdiğinde cihazın zincire yazdığı tarihli `review-decision` kaydının gövdesi. Kararın merkeze ulaşmasını sağlar; uzman başlığını, gerekçesini, kaynak metni ve istem içeriğini taşımaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "project_id",
    "snapshot_sha256",
    "decision",
    "reason_codes",
    "decision_sha256",
    "decided_at",
    "code_findings",
    "security_veto_findings",
    "raw_content_recorded"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "GovernedReviewDecisionEvent"},
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]{3,119}$"},
    "project_id": {"type": "string", "pattern": "^project-(?!0{32}$)[0-9a-f]{32}$"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {"enum": ["HARD-FAIL", "FAIL"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AGG_[A-Z0-9_]{1,60}$"}
    },
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "decided_at": {"$ref": "#/$defs/timestamp"},
    "code_findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "detector_id",
          "severity",
          "decision_effect",
          "path",
          "start_line",
          "end_line"
        ],
        "properties": {
          "agent_id": {"$ref": "#/$defs/agent_id"},
          "detector_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{2,159}$"},
          "severity": {"$ref": "#/$defs/severity"},
          "decision_effect": {"enum": ["hard-fail", "blocked-incomplete"]},
          "path": {"$ref": "#/$defs/path"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "security_veto_findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "finding_id", "severity", "locations"],
        "properties": {
          "agent_id": {"$ref": "#/$defs/agent_id"},
          "finding_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "severity": {"const": "critical"},
          "locations": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "start_line", "end_line"],
              "properties": {
                "path": {"$ref": "#/$defs/path"},
                "start_line": {"type": "integer", "minimum": 1},
                "end_line": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "raw_content_recorded": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "agent_id": {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/\\u0000-\\u001f\\u007f]+(?:/[^/\\u0000-\\u001f\\u007f]+)*$"
    }
  }
}
