{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-collector-record.schema.json",
  "title": "LogCollectorRecord",
  "description": "Toplayıcının değiştirilemez depoya kayıtların yanına yazdığı kendi kayıtları: doğrulama sonucu, ret, kimlik bağı, kimlik eşleme erişimi ve susan cihaz raporu. Hiçbiri ham UPN, anahtar veya kayıt içeriği taşımaz.",
  "oneOf": [
    {"$ref": "#/$defs/verification"},
    {"$ref": "#/$defs/rejection"},
    {"$ref": "#/$defs/identity_binding"},
    {"$ref": "#/$defs/identity_mapping"},
    {"$ref": "#/$defs/silent_devices"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device_id": {"type": "string", "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"},
    "stream_id": {"type": "string", "pattern": "^stream-[0-9a-f]{32}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "fingerprint": {"type": "string", "pattern": "^adfp:v1:[a-z0-9][a-z0-9-]{0,31}:[0-9a-f]{64}$"},
    "result": {
      "enum": ["verified", "gap", "mismatch", "rollback", "unanchored", "chain-unavailable", "epoch-restarted"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "received_at",
        "device_id",
        "runner",
        "nonce",
        "sent_at",
        "limitation",
        "retain_until",
        "records",
        "heads"
      ],
      "properties": {
        "schema": {"const": "kt-log-verification/v1"},
        "received_at": {"$ref": "#/$defs/timestamp"},
        "device_id": {"$ref": "#/$defs/device_id"},
        "runner": {"const": "user"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "sent_at": {"$ref": "#/$defs/timestamp"},
        "limitation": {"const": "pre-seal-changes-undetectable"},
        "retain_until": {"$ref": "#/$defs/timestamp"},
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object", "sha256", "stream_id", "epoch", "sequence", "result", "detail"],
            "properties": {
              "object": {"type": "string", "pattern": "^(?:records|files)/[0-9a-f]{64}\\.json$"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "stream_id": {"oneOf": [{"$ref": "#/$defs/stream_id"}, {"type": "null"}]},
              "epoch": {"type": ["integer", "null"], "minimum": 1},
              "sequence": {"type": ["integer", "null"], "minimum": 1},
              "result": {"$ref": "#/$defs/result"},
              "detail": {"type": ["string", "null"], "pattern": "^[a-z0-9-]{1,64}$"}
            }
          }
        },
        "heads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stream_id", "epoch", "sequence", "last_sha256", "seal", "result", "detail"],
            "properties": {
              "stream_id": {"$ref": "#/$defs/stream_id"},
              "epoch": {"type": "integer", "minimum": 1},
              "sequence": {"type": "integer", "minimum": 0},
              "last_sha256": {"$ref": "#/$defs/sha256"},
              "seal": {"$ref": "#/$defs/sha256"},
              "result": {"$ref": "#/$defs/result"},
              "detail": {"type": ["string", "null"], "pattern": "^[a-z0-9-]{1,64}$"}
            }
          }
        }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "received_at", "reason", "device_id"],
      "properties": {
        "schema": {"const": "kt-log-rejection/v1"},
        "received_at": {"$ref": "#/$defs/timestamp"},
        "reason": {
          "enum": [
            "request-too-large",
            "request-invalid",
            "seal-invalid",
            "outside-window",
            "nonce-replayed"
          ]
        },
        "device_id": {"oneOf": [{"$ref": "#/$defs/device_id"}, {"type": "null"}]}
      }
    },
    "identity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "device_id", "os_user", "fingerprint", "source", "first_seen", "last_seen"],
      "properties": {
        "schema": {"const": "kt-log-identity-binding/v1"},
        "device_id": {"$ref": "#/$defs/device_id"},
        "os_user": {"type": "string", "minLength": 1, "maxLength": 256},
        "fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "source": {
          "enum": ["mdm-managed", "sso-extension", "directory-binding", "windows-logon", "unavailable"]
        },
        "first_seen": {"$ref": "#/$defs/timestamp"},
        "last_seen": {"$ref": "#/$defs/timestamp"}
      }
    },
    "identity_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "at", "request_id", "fingerprint", "result"],
      "properties": {
        "schema": {"const": "kt-log-identity-mapping/v1"},
        "at": {"$ref": "#/$defs/timestamp"},
        "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
        "fingerprint": {"type": "string", "maxLength": 128},
        "result": {"enum": ["matched", "not-matched", "epoch-key-unavailable", "fingerprint-invalid"]}
      }
    },
    "silent_devices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "at", "threshold_minutes", "devices"],
      "properties": {
        "schema": {"const": "kt-log-silent-devices/v1"},
        "at": {"$ref": "#/$defs/timestamp"},
        "threshold_minutes": {"type": "integer", "minimum": 1},
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device_id", "last_seen", "runner"],
            "properties": {
              "device_id": {"$ref": "#/$defs/device_id"},
              "last_seen": {"$ref": "#/$defs/timestamp"},
              "runner": {"const": "user"}
            }
          }
        }
      }
    }
  }
}
