{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-forwarding-request.schema.json",
  "title": "LogForwardingRequest",
  "description": "Eşitleme betiğinin çağırdığı aktarım işlevinin toplayıcıya gönderdiği mühürlü istek. Kayıtlar diskteki baytlarıyla base64 olarak taşınır. İstek mührü X-KT-Seal başlığındadır; her akış başı ayrıca mühürlüdür. Kimlik bağındaki UPN yalnız bu istekte bulunur ve toplayıcıda saklanmaz.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "device_id", "runner", "nonce", "sent_at", "streams", "unchained"],
  "properties": {
    "schema": {"const": "kt-log-forward/v1"},
    "device_id": {"$ref": "#/$defs/device_id"},
    "runner": {"const": "user"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sent_at": {"$ref": "#/$defs/timestamp"},
    "streams": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_id", "project_id", "os_user", "head", "records", "attachments", "identity"],
        "properties": {
          "stream_id": {"type": "string", "pattern": "^stream-[0-9a-f]{32}$"},
          "project_id": {"$ref": "#/$defs/project_id"},
          "os_user": {"type": "string", "minLength": 1, "maxLength": 256},
          "head": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["epoch", "sequence", "last_sha256", "seal"],
                "properties": {
                  "epoch": {"type": "integer", "minimum": 1},
                  "sequence": {"type": "integer", "minimum": 0},
                  "last_sha256": {"$ref": "#/$defs/sha256"},
                  "seal": {"$ref": "#/$defs/sha256"}
                }
              }
            ]
          },
          "records": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["epoch", "sequence", "content"],
              "properties": {
                "epoch": {"type": "integer", "minimum": 1},
                "sequence": {"type": "integer", "minimum": 1},
                "content": {"$ref": "#/$defs/content"}
              }
            }
          },
          "attachments": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "name", "content"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]{3,119}$"},
                "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"},
                "content": {"$ref": "#/$defs/content"}
              }
            }
          },
          "identity": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["upn", "source", "observed_at"],
                "properties": {
                  "upn": {"type": ["string", "null"], "maxLength": 320},
                  "source": {
                    "enum": ["mdm-managed", "sso-extension", "directory-binding", "windows-logon", "unavailable"]
                  },
                  "observed_at": {"$ref": "#/$defs/timestamp"}
                }
              }
            ]
          }
        }
      }
    },
    "unchained": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "content"],
        "properties": {
          "project_id": {"$ref": "#/$defs/project_id"},
          "content": {"$ref": "#/$defs/content"}
        }
      }
    }
  },
  "$defs": {
    "device_id": {"type": "string", "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "content": {"type": "string", "contentEncoding": "base64", "maxLength": 5592408},
    "ack": {
      "description": "Toplayıcının cihaz anahtarıyla mühürlediği onay (X-KT-Seal). Akış başına bu istekte alınan en yüksek konumu ve alınan zincirsiz kayıtların özetlerini taşır.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "device_id", "nonce", "streams", "unchained"],
      "properties": {
        "schema": {"const": "kt-log-ack/v1"},
        "device_id": {"$ref": "#/$defs/device_id"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stream_id", "epoch", "sequence"],
            "properties": {
              "stream_id": {"type": "string", "pattern": "^stream-[0-9a-f]{32}$"},
              "epoch": {"type": "integer", "minimum": 1},
              "sequence": {"type": "integer", "minimum": 1}
            }
          }
        },
        "unchained": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
      }
    }
  }
}
