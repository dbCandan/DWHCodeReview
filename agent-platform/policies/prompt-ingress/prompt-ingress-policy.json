{
  "$schema": "../../prompt-ingress-policy.schema.json",
  "schema_version": "2.0",
  "kind": "PromptIngressPolicy",
  "metadata": {
    "id": "policy:prompt-ingress",
    "version": "1.6.0",
    "owner": "team:data-protection",
    "lifecycle": "phase-1-partial"
  },
  "scope": {
    "included_channel": "user-prompt-text",
    "excluded_channels": [
      "attachments",
      "auto-collected-workspace-context",
      "file-content",
      "mcp-output",
      "search-output",
      "shell-output",
      "tool-output"
    ],
    "gr_f01_coverage": "partial-phase-1"
  },
  "limits": {
    "max_event_bytes": 131072,
    "max_prompt_bytes": 65536
  },
  "persistence": {
    "capture_scope": "user-prompt-text-only",
    "clean_prompt": "exact",
    "sensitive_prompt": "risk-class-aware-redacted",
    "invalid_prompt": "unavailable",
    "redaction_strategy": "validated-detector-spans-v1",
    "redaction_token_template": "[REDACTED:{class}]",
    "whole_prompt_redaction_classes": [
      "labelled-secret",
      "private-key"
    ],
    "whole_prompt_redaction_strategy": "whole-prompt-redacted-v1",
    "whole_prompt_redaction_token": "[REDACTED:high-risk-prompt]",
    "digest_scope": "persisted-prompt-capture-only",
    "raw_sensitive_digest_allowed": false,
    "excluded_content_persistence": false
  },
  "term_lists": {
    "normalization": "nfkc-casefold-tr-v1",
    "digest": "hmac-sha256",
    "max_phrase_words": 3,
    "institution_list": "shared-governance-root/institution-terms.json",
    "sample": {
      "schema_version": "1.0",
      "kind": "InstitutionTermList",
      "sample": true,
      "version": "ornek-1.0.0",
      "key": "6f726e656b2d6c697374652d616e61687461722d6f726e656b2d6c697374652d",
      "lists": {
        "internal-hostnames": [
          "21ca0e6978ab4453237b4f7060d937f3ae78d50d2b6dd8fa7a09285fd50bc72b",
          "48e7c059ba17fd6e1048e6f3d89e2acef7d21433d0d418a270743b896ffb1605"
        ],
        "project-codenames": [
          "1be164600c470012eadebe2f51924cfc240560f860dbb607867e4a9c1e5d4813",
          "5ce5b011ba7939af96f04285ef5263ffa85e4ea8e523fb17e721eec150335e69",
          "72d869fcbd200d92025d23c900ba5f7944e9e9daa242b15f17a23918cc2349c8"
        ]
      }
    }
  },
  "detectors": [
    {
      "id": "detector:bilgi-guvenligi/sec-001",
      "class": "labelled-secret",
      "action": "block",
      "source_ref": "agent-platform/agents/bilgi-guvenligi/detectors.yml#detector:bilgi-guvenligi/sec-001",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "\\b(?:api[_-]?key|apikey|secret|password|passwd|token|access[_-]?token|auth[_-]?key)\\b\\s*[:=]\\s*(?:\\\"(?:\\\\.|[^\\\"\\\\\\r\\n]){8,}\\\"|'(?:\\\\.|[^'\\\\\\r\\n]){8,}'|[^\\s]{8,})",
        "flags": [
          "IGNORECASE"
        ],
        "validator": "secret-value-shape"
      }
    },
    {
      "id": "detector:bilgi-guvenligi/sec-002",
      "class": "cloud-access-key",
      "action": "block",
      "source_ref": "agent-platform/agents/bilgi-guvenligi/detectors.yml#detector:bilgi-guvenligi/sec-002",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
        "flags": [],
        "validator": null
      }
    },
    {
      "id": "detector:bilgi-guvenligi/sec-003",
      "class": "private-key",
      "action": "block",
      "source_ref": "agent-platform/agents/bilgi-guvenligi/detectors.yml#detector:bilgi-guvenligi/sec-003",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "-----BEGIN (?:[A-Z0-9]{1,24}(?: [A-Z0-9]{1,24}){0,3} )?PRIVATE KEY-----",
        "flags": [],
        "validator": "private-key-pem-block"
      }
    },
    {
      "id": "detector:bilgi-guvenligi/sec-005",
      "class": "email",
      "action": "block",
      "source_ref": "agent-platform/agents/bilgi-guvenligi/detectors.yml#detector:bilgi-guvenligi/sec-005",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?![A-Za-z0-9.-])",
        "flags": [],
        "validator": "email-address-shape"
      }
    },
    {
      "id": "detector:gizlilik-kvkk/priv-001",
      "class": "tckn",
      "action": "block",
      "source_ref": "agent-platform/agents/gizlilik-kvkk/detectors.yml#detector:gizlilik-kvkk/priv-001",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "(?<!\\d)[1-9]\\d{10}(?!\\d)",
        "flags": [],
        "validator": "tckn-checksum"
      }
    },
    {
      "id": "detector:gizlilik-kvkk/priv-002",
      "class": "iban",
      "action": "block",
      "source_ref": "agent-platform/agents/gizlilik-kvkk/detectors.yml#detector:gizlilik-kvkk/priv-002",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "\\bTR\\d{2}(?:[ ]?\\d{4}){5}[ ]?\\d{2}\\b",
        "flags": [
          "IGNORECASE"
        ],
        "validator": "iban-mod97"
      }
    },
    {
      "id": "detector:gizlilik-kvkk/priv-003",
      "class": "payment-card",
      "action": "block",
      "source_ref": "agent-platform/agents/gizlilik-kvkk/detectors.yml#detector:gizlilik-kvkk/priv-003",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "(?<!\\w)(?<!\\d[.,-])(?:\\d{13,19}|\\d{4}([ -])\\d{4}\\1\\d{4}\\1\\d{4}|3[47]\\d{2}([ -])\\d{6}\\2\\d{5})(?!\\w)(?![.,-]\\d)",
        "flags": [],
        "validator": "luhn-checksum"
      }
    },
    {
      "id": "detector:gizlilik-kvkk/priv-004",
      "class": "phone-number",
      "action": "block",
      "source_ref": "agent-platform/agents/gizlilik-kvkk/detectors.yml#detector:gizlilik-kvkk/priv-004",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "(?<![\\w+])(?<!\\d\\.)(?:(?:\\+?90[ .-]?0?|0)5\\d{2}[ .-]?\\d{3}[ .-]?\\d{2}[ .-]?\\d{2}|5\\d{2}[ -]\\d{3}[ -]\\d{2}[ -]\\d{2})(?!\\w)",
        "flags": [],
        "validator": null
      }
    },
    {
      "id": "detector:prompt-ingress/customer-number",
      "class": "customer-number",
      "action": "record-mask",
      "source_ref": "specs/agent-platform/PRDs/011-blocked-prompt-reasons-and-record-masking/PRD.md#b-maskeleme",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "(?<![^\\W_])(?:m[üu][şs]teri|customer|cust)[ _-]?(?:no|numaras[ıi]|number|num|nr|id)(?![^\\W_])[\\\"']?[ \\t]*[:=#]?[ \\t]*[\\\"']?(?P<value>\\d{6,12})(?!\\d)",
        "flags": [
          "IGNORECASE"
        ],
        "validator": null
      }
    },
    {
      "id": "detector:prompt-ingress/labelled-personal-field",
      "class": "labelled-personal-field",
      "action": "record-mask",
      "source_ref": "specs/agent-platform/PRDs/011-blocked-prompt-reasons-and-record-masking/PRD.md#b-maskeleme",
      "implementation": {
        "kind": "regex",
        "engine": "python-re",
        "pattern": "(?<![^\\W_])(?<!ip[ _-])(?<!mac[ _-])(?<!web[ _-])(?<!url[ _-])(?<!email[ _-])(?<!e-posta[ _-])(?<!eposta[ _-])(?<!mail[ _-])(?<!memory[ _-])(?<!bellek[ _-])(?<!bind[ _-])(?<!listen[ _-])(?<!server[ _-])(?<!sunucu[ _-])(?<!host[ _-])(?<!remote[ _-])(?<!local[ _-])(?<!base[ _-])(?<!wallet[ _-])(?<!public[ _-])(?<!proxy[ _-])(?<!gateway[ _-])(?:m[üu][şs]teri[ _-]?ad[ıi](?:[ _-]?soyad[ıi])?|ad[ _-]?soyad[ıi]?|(?:customer|client)[ _-]?(?:full[ _-]?)?name|full[ _-]?name|(?:(?:ev|i[şs]|teslimat|fatura)[ _-]?)?adres[ıi]?|(?:(?:home|billing|shipping|street|postal)[ _-]?)?address|do[ğg]um[ _-]?tarihi|birth[ _-]?date|date[ _-]of[ _-]birth|dob)(?![^\\W_])[\\\"']?[ \\t]*[:=][ \\t]*(?P<value>\\\"[^\\\"\\r\\n]{1,200}\\\"|'[^'\\r\\n]{1,200}'|[^\\s\\\"'=][^\\r\\n;]{0,199})",
        "flags": [
          "IGNORECASE"
        ],
        "validator": "labelled-field-value"
      }
    },
    {
      "id": "detector:prompt-ingress/internal-hostname",
      "class": "internal-hostname",
      "action": "record-mask",
      "source_ref": "specs/agent-platform/PRDs/011-blocked-prompt-reasons-and-record-masking/PRD.md#b-maskeleme",
      "implementation": {
        "kind": "term-list",
        "list": "internal-hostnames"
      }
    },
    {
      "id": "detector:prompt-ingress/project-codename",
      "class": "project-codename",
      "action": "record-mask",
      "source_ref": "specs/agent-platform/PRDs/011-blocked-prompt-reasons-and-record-masking/PRD.md#b-maskeleme",
      "implementation": {
        "kind": "term-list",
        "list": "project-codenames"
      }
    }
  ]
}
