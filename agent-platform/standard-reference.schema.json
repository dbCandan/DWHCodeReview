{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:standard-reference:1.0",
  "title": "Standart başvurusu ve standart kataloğu",
  "description": "Detektör ve politika paketlerindeki her `standard_refs` öğesinin tek biçimi. Her standart için kimlik, baskı, numara biçimi, izin verilen bağ durumları ve doğrulayan birim burada yazılıdır; kullanıcıya görünen adlar ve başlıklar karar açıklama kataloğundadır.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_id",
    "control_id",
    "version",
    "mapping_status"
  ],
  "properties": {
    "standard_id": {
      "enum": [
        "ISO-IEC-27001",
        "KVKK-6698",
        "CWE",
        "OWASP-TOP-10",
        "PCI-DSS",
        "SLSA",
        "KT-AGENT-POLICY"
      ]
    },
    "control_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "mapping_status": {
      "enum": [
        "baseline-unverified",
        "unit-verified",
        "source-stated-unverified",
        "institutional-policy-binding"
      ]
    },
    "verified_by": {
      "enum": [
        "role:information-security",
        "role:data-protection-legal"
      ]
    },
    "verified_on": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "standard_id": {
            "const": "ISO-IEC-27001"
          }
        },
        "required": [
          "standard_id"
        ]
      },
      "then": {
        "description": "ISO/IEC 27001:2022 Ek A, 93 kontrol (https://www.iso.org/standard/27001). Yalnız kontrol numarası ve kısa başlık tutulur; kontrol metni lisanslıdır ve kopyalanmaz. Doğrulayan birim: bilgi güvenliği.",
        "properties": {
          "control_id": {
            "pattern": "^A\\.(?:5\\.(?:[1-9]|[12][0-9]|3[0-7])|6\\.[1-8]|7\\.(?:[1-9]|1[0-4])|8\\.(?:[1-9]|[12][0-9]|3[0-4]))$"
          },
          "version": {
            "const": "2022"
          },
          "mapping_status": {
            "enum": [
              "baseline-unverified",
              "unit-verified"
            ]
          },
          "verified_by": {
            "const": "role:information-security"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "standard_id": {
            "const": "KVKK-6698"
          }
        },
        "required": [
          "standard_id"
        ]
      },
      "then": {
        "description": "6698 sayılı Kişisel Verilerin Korunması Kanunu, 7499 sayılı Kanun değişiklikleriyle 2024-06-01'den beri yürürlükteki metin (https://www.mevzuat.gov.tr/mevzuatmetin/1.5.6698.pdf). Numara `madde` ya da `madde/fıkra` biçimindedir. Doğrulayan birim: veri koruma ve hukuk.",
        "properties": {
          "control_id": {
            "pattern": "^(?:[1-9]|[12][0-9]|3[0-3])(?:/[1-9])?$"
          },
          "version": {
            "const": "2024-06-01"
          },
          "mapping_status": {
            "enum": [
              "baseline-unverified",
              "unit-verified"
            ]
          },
          "verified_by": {
            "const": "role:data-protection-legal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "standard_id": {
            "const": "CWE"
          }
        },
        "required": [
          "standard_id"
        ]
      },
      "then": {
        "description": "MITRE Common Weakness Enumeration (https://cwe.mitre.org). Yalnız kaynak metnin söylediği bağ için; baskı boştur.",
        "properties": {
          "control_id": {
            "pattern": "^CWE-[1-9][0-9]{0,4}$"
          },
          "version": {
            "type": "null"
          },
          "mapping_status": {
            "const": "source-stated-unverified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "standard_id": {
            "const": "OWASP-TOP-10"
          }
        },
        "required": [
          "standard_id"
        ]
      },
      "then": {
        "description": "OWASP Top 10 (https://owasp.org/www-project-top-ten/). Yalnız kaynak metnin söylediği bağ için; baskı boştur.",
        "properties": {
          "control_id": {
            "pattern": "^A(?:0[1-9]|10)$"
          },
          "version": {
            "type": "null"
          },
          "mapping_status": {
            "const": "source-stated-unverified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "standard_id": {
            "enum": [
              "PCI-DSS",
              "SLSA"
            ]
          }
        },
        "required": [
          "standard_id"
        ]
      },
      "then": {
        "description": "PCI DSS (https://www.pcisecuritystandards.org) ve SLSA (https://slsa.dev). Kaynak metin madde numarası vermediği için numara `source-stated` yazılır; baskı boştur.",
        "properties": {
          "control_id": {
            "const": "source-stated"
          },
          "version": {
            "type": "null"
          },
          "mapping_status": {
            "const": "source-stated-unverified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "standard_id": {
            "const": "KT-AGENT-POLICY"
          }
        },
        "required": [
          "standard_id"
        ]
      },
      "then": {
        "description": "Kurumun kendi ajan politikası kontrolü; numara politikadaki kontrol kimliğidir.",
        "properties": {
          "control_id": {
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "mapping_status": {
            "const": "institutional-policy-binding"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mapping_status": {
            "const": "unit-verified"
          }
        },
        "required": [
          "mapping_status"
        ]
      },
      "then": {
        "required": [
          "verified_by",
          "verified_on"
        ]
      },
      "else": {
        "allOf": [
          {
            "not": {
              "required": [
                "verified_by"
              ]
            }
          },
          {
            "not": {
              "required": [
                "verified_on"
              ]
            }
          }
        ]
      }
    }
  ]
}
