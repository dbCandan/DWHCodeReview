ARG PYTHON_BASE_IMAGE=registry.internal.invalid/platform/python:3.14-alpine3.23@sha256:218761489de417a6eb0808e264cbdd7043ec6659fe5a61898815e9848536541d
FROM scratch AS python_wheelhouse
FROM scratch AS system_packages
FROM ${PYTHON_BASE_IMAGE}

ARG APP_GID=10001
ARG APP_UID=10001
ARG DEPENDENCY_MODE=offline
ARG TARGETARCH

ENV HOME=/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/app/backend \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

RUN addgroup -g "${APP_GID}" app \
    && adduser -D -H -u "${APP_UID}" -G app app

WORKDIR /workspace/app/backend
# unixODBC, the Microsoft ODBC driver and the organization root CA; every package is digest-locked
# in app/infra/locks and apk installs without network access.
COPY app/infra/locks/backend-alpine-packages.lock app/infra/locks/msodbcsql18-alpine-packages.lock /tmp/system-locks/
COPY app/infra/install-backend-system-packages.sh /tmp/system-locks/install.sh
COPY app/backend/certs/corporate-inference-root.crt /tmp/system-locks/corporate-inference-root.crt
RUN --mount=type=bind,from=system_packages,source=/,target=/opt/system-packages \
    sh /tmp/system-locks/install.sh "${DEPENDENCY_MODE}" "${TARGETARCH}" /tmp/system-locks \
        /opt/system-packages /tmp/system-locks/corporate-inference-root.crt \
    && rm -rf /tmp/system-locks

# pip leaves the image once the hash-locked requirements are installed: nothing installs packages at
# run time, and the base image's pip carries its own vendored certifi, urllib3, msgpack and setuptools.
COPY app/backend/requirements.txt /tmp/dependencies/requirements.txt
RUN --mount=type=bind,from=python_wheelhouse,source=/,target=/opt/wheelhouse \
    --mount=type=secret,id=pip_conf,target=/etc/pip.conf,required=false \
    set -eu; \
    case "${DEPENDENCY_MODE}" in \
        connected) python -m pip install --no-cache-dir -r /tmp/dependencies/requirements.txt ;; \
        offline) PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 python -m pip install \
            --no-cache-dir --no-index --find-links=/opt/wheelhouse \
            -r /tmp/dependencies/requirements.txt ;; \
        *) echo "DEPENDENCY_MODE must be connected or offline" >&2; exit 64 ;; \
    esac; \
    python -m pip uninstall --yes pip; \
    rm -rf /tmp/dependencies

COPY --chown=${APP_UID}:${APP_GID} app/backend/app ./app
COPY --chown=${APP_UID}:${APP_GID} app/backend/alembic.ini ./alembic.ini
COPY --chown=${APP_UID}:${APP_GID} schema /workspace/schema
# Public CA bundle of the nonprod LDAPS directory (application-foundation/PRDs/001-directory-login
# Requirement 10); the deployment names it in DWHCODEREVIEW_DIRECTORY_CA_BUNDLE_PATH.
COPY app/backend/certs/nonprod-directory-ca.crt ./certs/nonprod-directory-ca.crt

USER ${APP_UID}:${APP_GID}
EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
